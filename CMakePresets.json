{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64",
      "description": "Configure a RelWithDebInfo Apple Silicon build using Homebrew Qt.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_root/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt",
        "KLOGG_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 Release",
      "description": "Configure a Release Apple Silicon build using Homebrew Qt.",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build_root/macos-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    }
  ]
}
